# Database
# For production (Render PostgreSQL): DATABASE_URL="postgresql://user:password@host:port/database"
# For local development with PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/medbrief"
# Note: This project uses PostgreSQL provider. For local SQLite dev, temporarily change schema provider to "sqlite"
DATABASE_URL="postgresql://postgres:password@localhost:5432/medbrief"

# Authentication
# Generate a strong random secret for production (e.g., openssl rand -base64 32)
JWT_SECRET="change-me-in-production"

# Frontend URL(s) - comma-separated list of allowed origins for CORS
# Include your Vercel deployment URL and localhost for development
FRONTEND_URL="http://localhost:5173,http://localhost:3000"

# AI Provider Configuration
# Options: "mock" | "watsonx"
AI_PROVIDER="mock"

# IBM WatsonX (required if AI_PROVIDER="watsonx")
WATSONX_API_KEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL="https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_ID="ibm/granite-13b-chat-v2"

# Server Port (Render sets PORT automatically, default 5000 for local)
PORT=5000
