# MedBrief AI â€” Top-level environment variable reference
# The actual environment file is: src/server/.env
# Copy: cp src/server/.env.example src/server/.env
# See src/server/.env.example for full variable reference.

# Database (SQLite â€” path relative to src/server/)
DATABASE_URL="file:./prisma/dev.db"

# Authentication (REQUIRED for live mode â€” generate with: openssl rand -base64 32)
JWT_SECRET="change-me-in-production"

# Frontend URL(s) for CORS
FRONTEND_URL="http://localhost:5173,http://localhost:3000"

# AI Provider: "mock" (default) | "watsonx"
AI_PROVIDER="mock"

# IBM watsonx.ai (required only when AI_PROVIDER=watsonx)
WATSONX_API_KEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL="https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_ID="ibm/granite-13b-chat-v2"

PORT=5000